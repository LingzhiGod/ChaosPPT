{
  "name": "chaosppt",
  "version": "0.2.0",
  "description": "Agent-first HTML presentation renderer with PDF and image-PPTX export",
  "type": "module",
  "bin": {
    "chaosppt": "src/cli.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "demo": "node src/cli.js dev examples/demo",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "assets",
    "templates",
    "skills",
    "README.md",
    "scripts"
  ],
  "dependencies": {
    "fflate": "^0.8.2",
    "parse5": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.0",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.0.0"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
