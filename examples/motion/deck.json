{
  "version": 1,
  "title": "ChaosPPT · 控件动画与平滑过渡",
  "size": { "width": 1600, "height": 900 },
  "theme": "theme.css",
  "fonts": [
    {
      "family": "Noto Sans SC",
      "file": "assets/NotoSansSC.ttf",
      "weight": "100 900"
    }
  ],
  "render": { "timeoutMs": 30000, "scale": 2 },
  "slides": [
    {
      "id": "entrance",
      "file": "01.html",
      "title": "进入与展开",
      "notes": "首次自动淡入；第一次点击飞入；第二次点击条形依次展开；再点击进入下一页"
    },
    {
      "id": "shared-a",
      "file": "02.html",
      "title": "共享组件起点",
      "transition": { "effect": "fade", "durationMs": 400 },
      "notes": "下一页用相同 shared key 匹配 focus-card"
    },
    {
      "id": "shared-b",
      "file": "03.html",
      "title": "共享组件终点",
      "transition": { "effect": "morph", "durationMs": 900 },
      "notes": "卡片保持同一共享标识，改变位置与尺寸；点击展开左侧条形"
    },
    {
      "id": "exit",
      "file": "04.html",
      "title": "离场效果",
      "transition": { "effect": "fade", "durationMs": 400 },
      "notes": "依次点击：左组淡出，中组向右飞出，右组从左擦除"
    }
  ]
}
